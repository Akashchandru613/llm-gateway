# Copy this file to .env and fill in real values. NEVER commit .env.
# All configuration is read from the environment (12-factor).

# HTTP port the gateway listens on.
PORT=8080

# OpenAI API key (REQUIRED). Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# OpenAI API base URL. Override to point at a mock or proxy; default is OpenAI's.
OPENAI_BASE_URL=https://api.openai.com/v1

# Per-request upstream timeout, in Go duration syntax (e.g. 30s, 2m, 90s).
REQUEST_TIMEOUT=60s
